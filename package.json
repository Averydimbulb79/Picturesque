{
  "name": "picturesque",
  "version": "0.4.9",
  "description": "Picturesque browser and Windows image editor",
  "author": "Mike",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --write index.html src styles desktop tests package.json",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "pack:win": "electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "sg.picturesque.editor",
    "productName": "Picturesque",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "src/**",
      "styles/**",
      "desktop/**",
      "package.json"
    ],
    "asar": true,
    "artifactName": "Picturesque-${version}-Windows-${arch}-Setup.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "picturesque",
        "name": "Picturesque project",
        "role": "Editor"
      },
      {
        "ext": "picturesque-workspace",
        "name": "Picturesque workspace",
        "role": "Editor"
      }
    ]
  }
}
